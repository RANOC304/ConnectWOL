{
  "name": "connectwol",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Self-hosted Wake-on-LAN web app with unlimited devices, a guided setup wizard and PWA install.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.3",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
