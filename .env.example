# Copy to .env (never commit it). Every variable is optional.

# Where the SQLite database file is stored. Created on first start.
DATABASE_PATH=./data/connectwol.db

# Port and bind address of the web server.
PORT=3000
HOSTNAME=0.0.0.0

# Set to true ONLY when the app sits behind a reverse proxy you control (Caddy, nginx, Traefik...).
# Then X-Forwarded-For / X-Forwarded-Proto / X-Forwarded-Host are trusted for rate limiting,
# the Secure cookie flag and the Origin check. Never enable it when the app is directly reachable.
TRUST_PROXY=false

# auto (default): Secure cookie when the request arrived over HTTPS. Use true to force it.
COOKIE_SECURE=auto

# Optional. If set, creating the first admin account requires this token. Recommended whenever the
# app is reachable by people other than you before you complete the first-run setup.
SETUP_TOKEN=

# Optional extra origins allowed to call the API, comma separated (rarely needed).
ALLOWED_ORIGINS=

# Session lifetime in days (sliding).
SESSION_TTL_DAYS=30

# Next.js's build tooling has its own anonymous telemetry, unrelated to this app (which sends
# nothing). The Docker image disables it; set this for local builds too.
NEXT_TELEMETRY_DISABLED=1
